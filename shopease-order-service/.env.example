MYSQL_DATABASE=shopease_order_db
MYSQL_USER=shopease_order
MYSQL_PASSWORD=replace-with-a-strong-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-local-root-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_FILE=../shopease-auth-service/keys/jwt_public.pem
AUTH_SERVICE_URL=http://localhost:8002
USER_SERVICE_URL=http://localhost:8004
PRODUCT_SERVICE_URL=http://localhost:8005
CATALOG_SERVICE_API_KEY=replace-with-a-long-random-shared-service-key
USER_SERVICE_URL_DOCKER=http://host.docker.internal:8004
PRODUCT_SERVICE_URL_DOCKER=http://host.docker.internal:8005
DEFAULT_SHIPPING_CHARGE=10.00
TAX_RATE=0.10
