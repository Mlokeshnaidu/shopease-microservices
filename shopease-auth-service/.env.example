APP_NAME=ShopEase Authentication Service
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=shopease_auth_db
MYSQL_USER=shopease_app
MYSQL_PASSWORD=replace-with-a-unique-url-safe-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
JWT_PRIVATE_KEY_FILE=keys/jwt_private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt_public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
